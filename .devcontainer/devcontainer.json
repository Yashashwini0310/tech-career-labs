{
  "name": "Tech Career Labs",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false }
  },
  "forwardPorts": [8080, 5000, 5432],
  "portsAttributes": {
    "8080": { "label": "Lab website (nginx)" },
    "5000": { "label": "Orders API" },
    "5432": { "label": "PostgreSQL" }
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq postgresql-client jq >/dev/null; chmod +x */lab.sh || true",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}