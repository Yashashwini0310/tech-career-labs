{
  "name": "Tech Career Labs",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [8080, 5000, 5432],
  "portsAttributes": {
    "8080": { "label": "Lab website (nginx)" },
    "5000": { "label": "Orders API" },
    "5432": { "label": "PostgreSQL" }
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq postgresql-client jq >/dev/null && chmod +x */lab.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker", "mtxr.sqltools", "mtxr.sqltools-driver-pg"]
    }
  }
}
